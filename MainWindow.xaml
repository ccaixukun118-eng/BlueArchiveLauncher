<Window x:Class="BlueArchiveLauncher.MainWindow"         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"         Title="碧蓝档案启动器"         Width="1380"         Height="860"         MinWidth="1120"         MinHeight="720"         WindowStartupLocation="CenterScreen"         Background="{StaticResource WindowBackgroundBrush}"         Foreground="{StaticResource TextPrimaryBrush}">   <Grid>     <Grid.ColumnDefinitions>       <ColumnDefinition Width="248" />       <ColumnDefinition Width="*" />     </Grid.ColumnDefinitions>      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">       <DockPanel>         <StackPanel DockPanel.Dock="Bottom" Margin="18,16">           <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">             <StackPanel>               <TextBlock Text="系统状态" FontWeight="SemiBold" FontSize="12" />               <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />             </StackPanel>           </Border>           <TextBlock Text="第一版 · 数据接入准备中" Style="{StaticResource CaptionStyle}" Margin="2,12,0,0" />         </StackPanel>          <ScrollViewer VerticalScrollBarVisibility="Auto">           <StackPanel Margin="18,22">             <StackPanel Orientation="Horizontal" Margin="0,0,0,22">               <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="6">                 <TextBlock Text="BA" Foreground="#0B1B2A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />               </Border>               <StackPanel Margin="10,1,0,0">                 <TextBlock Text="SCHale" FontWeight="Bold" FontSize="17" />                 <TextBlock Text="三服启动器" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />               </StackPanel>             </StackPanel>              <TextBlock Text="服务器" Style="{StaticResource CaptionStyle}" Margin="2,0,0,3" />             <RadioButton Content="国际服"                          GroupName="Server"                          Style="{StaticResource ServerButtonStyle}"                          IsChecked="{Binding IsGlobalSelected, Mode=OneWay}"                          Command="{Binding SwitchServerCommand}"                          CommandParameter="Global" />             <RadioButton Content="国服"                          GroupName="Server"                          Style="{StaticResource ServerButtonStyle}"                          IsChecked="{Binding IsCnSelected, Mode=OneWay}"                          Command="{Binding SwitchServerCommand}"                          CommandParameter="CN" />             <RadioButton Content="日服"                          GroupName="Server"                          Style="{StaticResource ServerButtonStyle}"                          IsChecked="{Binding IsJpSelected, Mode=OneWay}"                          Command="{Binding SwitchServerCommand}"                          CommandParameter="JP" />              <TextBlock Text="工作台" Style="{StaticResource CaptionStyle}" Margin="2,26,0,3" />             <Button Content="⌂  总览" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />             <Button Content="♙  角色数据库" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Characters" />             <Button Content="◆  总力战" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Raid" />             <Button Content="▣  活动与公告" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Events" />             <Button Content="⌁  兑换码" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Codes" />              <TextBlock Text="系统" Style="{StaticResource CaptionStyle}" Margin="2,26,0,3" />             <Button Content="⚙  设置" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />             <Button Content="◎  诊断" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />           </StackPanel>         </ScrollViewer>       </DockPanel>     </Border>      <Grid Grid.Column="1" Margin="30,24,30,22">       <Grid.RowDefinitions>         <RowDefinition Height="Auto" />         <RowDefinition Height="Auto" />         <RowDefinition Height="*" />         <RowDefinition Height="Auto" />       </Grid.RowDefinitions>        <Grid Grid.Row="0" Margin="0,0,0,20">         <StackPanel>           <TextBlock Text="{Binding SectionTitle}" FontSize="27" FontWeight="SemiBold" />           <TextBlock Text="{Binding SectionSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />         </StackPanel>         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">           <Border Style="{StaticResource PillStyle}" Margin="0,0,12,0">             <StackPanel Orientation="Horizontal">               <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />               <TextBlock Text="{Binding ActiveServerLabel}" FontSize="11" />             </StackPanel>           </Border>           <Button Content="↻  刷新" Style="{StaticResource QuietButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />           <Button Content="启动并连接" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LaunchGameCommand}" />         </StackPanel>       </Grid>        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">         <Grid>           <Grid.ColumnDefinitions>             <ColumnDefinition Width="*" />             <ColumnDefinition Width="Auto" />           </Grid.ColumnDefinitions>           <StackPanel>             <TextBlock Text="{Binding HeroEyebrow}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />             <TextBlock Text="{Binding HeroTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />             <TextBlock Text="{Binding HeroDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="650" Margin="0,7,0,0" />           </StackPanel>           <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">             <TextBlock Text="最近同步" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />             <TextBlock Text="{Binding LastSyncLabel}" FontSize="13" HorizontalAlignment="Right" Margin="0,4,0,0" />             <TextBlock Text="{Binding DataSourceLabel}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" Margin="0,3,0,0" />           </StackPanel>         </Grid>       </Border>        <Grid Grid.Row="2">         <Grid.ColumnDefinitions>           <ColumnDefinition Width="1.15*" />           <ColumnDefinition Width="1*" />           <ColumnDefinition Width="0.9*" />         </Grid.ColumnDefinitions>         <Grid.RowDefinitions>           <RowDefinition Height="1.04*" />           <RowDefinition Height="0.96*" />         </Grid.RowDefinitions>          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">           <DockPanel>             <StackPanel DockPanel.Dock="Top">               <TextBlock Text="当前卡池" Style="{StaticResource SectionTitleStyle}" />               <TextBlock Text="{Binding BannerWindow}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,-5,0,10" />             </StackPanel>             <Grid>               <Grid.ColumnDefinitions>                 <ColumnDefinition Width="76" />                 <ColumnDefinition Width="*" />               </Grid.ColumnDefinitions>               <Border Width="62" Height="62" Background="{StaticResource CoralBrush}" CornerRadius="31" VerticalAlignment="Top">                 <TextBlock Text="{Binding BannerInitials}" Foreground="#44251F" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />               </Border>               <StackPanel Grid.Column="1" Margin="12,0,0,0">                 <TextBlock Text="{Binding BannerName}" FontSize="16" FontWeight="SemiBold" />                 <TextBlock Text="{Binding BannerType}" Foreground="{StaticResource GoldBrush}" FontSize="11" Margin="0,5,0,0" />                 <TextBlock Text="{Binding BannerDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />               </StackPanel>             </Grid>           </DockPanel>         </Border>          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,12">           <DockPanel>             <StackPanel DockPanel.Dock="Top">               <TextBlock Text="总力战" Style="{StaticResource SectionTitleStyle}" />               <TextBlock Text="{Binding RaidWindow}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,-5,0,12" />             </StackPanel>             <StackPanel>               <TextBlock Text="{Binding RaidName}" FontSize="16" FontWeight="SemiBold" />               <StackPanel Orientation="Horizontal" Margin="0,8,0,0">                 <Border Style="{StaticResource PillStyle}" Background="#5B3F46" Margin="0,0,7,0">                   <TextBlock Text="{Binding RaidArmor}" FontSize="10" />                 </Border>                 <Border Style="{StaticResource PillStyle}" Background="#3A4D5C">                   <TextBlock Text="{Binding RaidDifficulty}" FontSize="10" />                 </Border>               </StackPanel>               <TextBlock Text="{Binding RaidHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />               <Button Content="查看推荐角色  →" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Margin="0,13,0,0" Command="{Binding NavigateCommand}" CommandParameter="Raid" />             </StackPanel>           </DockPanel>         </Border>          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">           <DockPanel>             <TextBlock Text="模拟器连接" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Top" />             <StackPanel>               <Grid Margin="0,0,0,12">                 <TextBlock Text="MuMu 模拟器" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />                 <TextBlock Text="{Binding MumuStatusLabel}" HorizontalAlignment="Right" Foreground="{Binding MumuStatusBrush}" FontSize="11" />               </Grid>               <Grid Margin="0,0,0,12">                 <TextBlock Text="MuMu 位置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />                 <TextBlock Text="{Binding MumuShortcutLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />               </Grid>               <Grid>                 <TextBlock Text="数据状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />                 <TextBlock Text="{Binding DataSourceLabel}" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrush}" FontSize="11" />               </Grid>               <TextBlock Text="{Binding MumuStatusDetail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />               <Button Content="{Binding MumuActionLabel}" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Margin="0,13,0,0" Command="{Binding LaunchGameCommand}" />             </StackPanel>           </DockPanel>         </Border>          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">           <DockPanel>             <TextBlock Text="活动与公告" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Top" />             <ItemsControl ItemsSource="{Binding Announcements}">               <ItemsControl.ItemTemplate>                 <DataTemplate>                   <Grid Margin="0,0,0,12">                     <Grid.ColumnDefinitions>                       <ColumnDefinition Width="Auto" />                       <ColumnDefinition Width="*" />                     </Grid.ColumnDefinitions>                     <Border Background="{StaticResource SurfaceStrongBrush}" CornerRadius="3" Padding="6,3">                       <TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="10" />                     </Border>                     <StackPanel Grid.Column="1" Margin="10,0,0,0">                       <TextBlock Text="{Binding Title}" FontSize="12" />                       <TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" />                     </StackPanel>                   </Grid>                 </DataTemplate>               </ItemsControl.ItemTemplate>             </ItemsControl>           </DockPanel>         </Border>          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">           <DockPanel>             <TextBlock Text="总力战推荐角色" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Top" />             <ItemsControl ItemsSource="{Binding RaidRecommendations}">               <ItemsControl.ItemTemplate>                 <DataTemplate>                   <Grid Margin="0,0,0,10">                     <Grid.ColumnDefinitions>                       <ColumnDefinition Width="36" />                       <ColumnDefinition Width="*" />                       <ColumnDefinition Width="Auto" />                     </Grid.ColumnDefinitions>                     <Border Width="28" Height="28" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">                       <TextBlock Text="{Binding Initials}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />                     </Border>                     <StackPanel Grid.Column="1" Margin="8,0,0,0">                       <TextBlock Text="{Binding Name}" FontSize="12" />                       <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" />                     </StackPanel>                     <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}" Foreground="{StaticResource GoldBrush}" FontSize="11" VerticalAlignment="Center" />                   </Grid>                 </DataTemplate>               </ItemsControl.ItemTemplate>             </ItemsControl>           </DockPanel>         </Border>          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">           <DockPanel>             <TextBlock Text="兑换码" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Top" />             <StackPanel>               <TextBlock Text="{Binding CodeName}" FontSize="13" FontWeight="SemiBold" />               <TextBlock Text="{Binding CodeExpiry}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />               <Border Background="{StaticResource SurfaceStrongBrush}" CornerRadius="4" Padding="10" Margin="0,16,0,0">                 <TextBlock Text="{Binding CodeValue}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" FontSize="13" />               </Border>               <TextBlock Text="{Binding CodeStatus}" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,9,0,0" />               <ItemsControl ItemsSource="{Binding RedeemCodes}" Margin="0,12,0,0">                 <ItemsControl.ItemTemplate>                   <DataTemplate>                     <Grid Margin="0,0,0,6">                       <Grid.ColumnDefinitions>                         <ColumnDefinition Width="*" />                         <ColumnDefinition Width="Auto" />                       </Grid.ColumnDefinitions>                       <TextBlock Text="{Binding Value}"                                  FontFamily="Consolas"                                  Foreground="{StaticResource AccentBrush}"                                  FontSize="11"                                  VerticalAlignment="Center"                                  TextTrimming="CharacterEllipsis"                                  ToolTip="{Binding Reward}" />                       <Button Grid.Column="1"                               Content="复制"                               Style="{StaticResource QuietButtonStyle}"                               Padding="8,3"                               Margin="8,0,0,0"                               Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"                               CommandParameter="{Binding Value}" />                     </Grid>                   </DataTemplate>                 </ItemsControl.ItemTemplate>               </ItemsControl>               <Button Content="复制兑换码" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Margin="0,7,0,0" Command="{Binding CopyCodeCommand}" />             </StackPanel>           </DockPanel>         </Border>       </Grid>        <Grid Grid.Row="3" Margin="0,18,0,0">         <TextBlock Text="{Binding FooterMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />         <TextBlock Text="{Binding CurrentNavLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />       </Grid>     </Grid>   </Grid> </Window>